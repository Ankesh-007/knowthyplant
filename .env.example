# LocalHands / BuildVantage — Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
#
# These are read by Vite (the VITE_ prefix exposes them to the browser bundle).
# The anon key is public by design — Row-Level Security protects the data.
# In production, set these as build environment variables in Netlify.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
